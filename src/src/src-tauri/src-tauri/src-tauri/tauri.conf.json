{
  "productName": "Horizon Launcher",
  "identifier": "com.horizon.launcher",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Horizon Launcher", "width": 400, "height": 800, "resizable": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: asset: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "android": { "minSdkVersion": 26 } }
}
